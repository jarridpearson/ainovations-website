# This site's publish directory is the whole repo, so without these rules
# every other project's full source (including live edge function code)
# is publicly reachable at ainovations.net/<dir>/... Netlify splats only
# match nested paths when anchored at the end of the pattern (/dir/*), not
# as a mid-pattern suffix (/*.md) — that form only ever matches single-
# segment paths, so it silently fails to catch anything nested.
/supabase/*         /404.html 404!
/everward-portal/*  /404.html 404!
/node_modules/*     /404.html 404!
/cow-flicker/*       /404.html 404!
/ringlatch-src/*    /404.html 404!
# rent-an-app has its own public site at rent-an-app.ainovations.net;
# this directory is just its source, never served here.
/rent-an-app/*      /404.html 404!

# kick-a-donut has its own public site and index.html here links directly
# to kick-a-donut/assets/icon-512.png, so only its internal docs/config
# are blocked — the rest is meant to be public anyway.
/kick-a-donut/README.md   /404.html 404!
/kick-a-donut/_redirects  /404.html 404!
/kick-a-donut/_headers    /404.html 404!

# The web-developer brief is an internal working document that happens to
# live in the web root so it can be published as an Artifact. It is not
# linked from anywhere, but robots.txt allows everything, so without this
# it is one crawl away from being indexed.
/chalkline-web-brief.html /404.html 404!

